            <avrtb:EditableInlineUIContainer.Content>
            <Image Width="100" Height="50" Stretch="Uniform" Source="avares://DemoApp_AvRichTextBox/Assets/avalonia-logo.ico"/>
            </avrtb:EditableInlineUIContainer.Content>
            </avrtb:EditableInlineUIContainer>
